<!DOCTYPE html>
<html>
<head>
    <title>Student Management System</title>

    <style>
        body {
            font-family: Arial, sans-serif;
            text-align: center;
            margin-top: 50px;
            background: #f5f5f5;
        }

        h1 {
            margin-bottom: 30px;
        }

        .add-btn {
            text-decoration: none;
            padding: 10px 20px;
            background: #333;
            color: white;
            border-radius: 5px;
        }

        ul {
            list-style: none;
            padding: 0;
            margin-top: 30px;
        }

        li {
            background: white;
            margin: 15px auto;
            padding: 20px;
            width: 500px;
            border-radius: 8px;
        }

        .edit-btn,
        .delete-btn {
            display: inline-block;
            padding: 8px 15px;
            margin: 10px 5px 0;
            border-radius: 5px;
            text-decoration: none;
            color: white;
            border: none;
            cursor: pointer;
        }

        .edit-btn {
            background: #333;
        }

        .delete-btn {
            background: #c0392b;
        }

        .delete-form {
            display: inline;
        }
    </style>
</head>

<body>

    <h1>Student Management System</h1>

    <a class="add-btn" href="/students/new">Add Student</a>

    <ul>

        <% students.forEach(student => { %>

            <li>

                <strong><%= student.name %></strong>

                <br><br>

                <%= student.email %>
                <br>
                <%= student.course %>
                <br>
                Age: <%= student.age %>

                <br>

                <!-- EDIT BUTTON -->
                <a class="edit-btn"
                   href="/students/<%= student._id %>/edit">
                    Edit
                </a>

                <!-- DELETE BUTTON -->
                <form class="delete-form"
                      action="/students/<%= student._id %>/delete"
                      method="POST">

                    <button class="delete-btn" type="submit">
                        Delete
                    </button>

                </form>

            </li>

        <% }) %>

    </ul>

</body>
</html>